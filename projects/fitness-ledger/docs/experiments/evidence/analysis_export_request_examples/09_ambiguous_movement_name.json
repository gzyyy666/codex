{
  "request_version": "1.1",
  "purpose": "Request movement progress for the movement referred to as 推胸; resolve identity before export.",
  "datasets": [{
    "dataset_id": "ambiguous_movement",
    "type": "movement_progress",
    "time_range": {"mode": "latest_matching_sessions", "sessions": 3},
    "filters": {"movement_selector": {"kind": "movement_name", "value": "推胸"}},
    "fields": ["date", "movement_id", "movement_name", "body_part", "sets"]
  }],
  "raw": false,
  "output": {"formats": ["json"]}
}
