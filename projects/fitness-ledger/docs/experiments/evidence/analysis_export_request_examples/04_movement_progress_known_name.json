{
  "request_version": "1.1",
  "purpose": "Compare the progress history of the known bench press movement.",
  "datasets": [{
    "dataset_id": "movement_bench",
    "type": "movement_progress",
    "time_range": {"mode": "latest_matching_sessions", "sessions": 3},
    "filters": {"movement_selector": {"kind": "movement_name", "value": "卧推"}},
    "fields": ["date", "movement_id", "movement_name", "variant", "sets"],
    "set_roles": ["top", "working"]
  }],
  "raw": false,
  "output": {"formats": ["json", "markdown"]}
}
