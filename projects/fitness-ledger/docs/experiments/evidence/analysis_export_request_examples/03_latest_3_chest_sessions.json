{
  "request_version": "1",
  "purpose": "Review the latest three chest training sessions.",
  "datasets": [{
    "type": "training",
    "time_range": {"mode": "latest_matching_sessions", "sessions": 3},
    "filters": {"body_part": "chest"},
    "fields": ["date", "split", "standardized_summary"],
    "include_notes": false
  }],
  "notes_scope": [],
  "raw": false,
  "output": {"formats": ["json", "markdown"]}
}
