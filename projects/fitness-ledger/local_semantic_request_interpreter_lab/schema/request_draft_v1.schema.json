{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fitness-ledger://schemas/request-draft-v1",
  "title": "Fitness Ledger Local RequestDraft v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "fitness-ledger-request-draft-v1" },
    "status": { "enum": ["ready", "needs_confirmation", "unsupported"] },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 500 },
    "datasets": {
      "type": "array",
      "maxItems": 4,
      "items": { "$ref": "#/$defs/dataset" }
    },
    "relations": {
      "type": "array",
      "maxItems": 4,
      "items": { "$ref": "#/$defs/relation" }
    },
    "missing_confirmations": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    }
  },
  "required": ["schema_version", "status", "purpose", "datasets", "relations", "missing_confirmations", "warnings"],
  "$defs": {
    "dataset": {
      "oneOf": [
        { "$ref": "#/$defs/body_dataset" },
        { "$ref": "#/$defs/diet_dataset" },
        { "$ref": "#/$defs/training_dataset" },
        { "$ref": "#/$defs/movement_progress_dataset" }
      ]
    },
    "body_dataset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "draft_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,48}$" },
        "kind": { "const": "body" },
        "scope": { "$ref": "#/$defs/empty_scope" },
        "time_intent": { "$ref": "#/$defs/time_intent" },
        "requested_information": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "enum": ["date", "weight", "bowel_movement", "training_label", "cardio_summary"] } },
        "notes": { "$ref": "#/$defs/notes" }
      },
      "required": ["draft_id", "kind", "scope", "time_intent", "requested_information", "notes"]
    },
    "diet_dataset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "draft_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,48}$" },
        "kind": { "const": "diet" },
        "scope": { "$ref": "#/$defs/empty_scope" },
        "time_intent": { "$ref": "#/$defs/time_intent" },
        "requested_information": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "enum": ["date", "energy", "protein", "carbohydrate", "fat", "food_summary"] } },
        "notes": { "$ref": "#/$defs/notes" }
      },
      "required": ["draft_id", "kind", "scope", "time_intent", "requested_information", "notes"]
    },
    "training_dataset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "draft_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,48}$" },
        "kind": { "const": "training" },
        "scope": { "$ref": "#/$defs/training_scope" },
        "time_intent": { "$ref": "#/$defs/time_intent" },
        "requested_information": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "enum": ["date", "session", "split", "movements", "sets", "training_notes"] } },
        "notes": { "$ref": "#/$defs/notes" }
      },
      "required": ["draft_id", "kind", "scope", "time_intent", "requested_information", "notes"]
    },
    "movement_progress_dataset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "draft_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,48}$" },
        "kind": { "const": "movement_progress" },
        "scope": { "$ref": "#/$defs/training_scope" },
        "time_intent": { "$ref": "#/$defs/time_intent" },
        "requested_information": { "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": { "enum": ["date", "movement", "body_part", "variant", "order", "sets", "load", "repetitions", "movement_notes"] } },
        "notes": { "$ref": "#/$defs/notes" }
      },
      "required": ["draft_id", "kind", "scope", "time_intent", "requested_information", "notes"]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "body_part": { "type": "string", "minLength": 1, "maxLength": 80 },
        "movement": { "type": "string", "minLength": 1, "maxLength": 120 },
        "split": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "empty_scope": {
      "type": "object",
      "additionalProperties": false
    },
    "training_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "body_part": { "type": "string", "minLength": 1, "maxLength": 80 },
        "movement": { "type": "string", "minLength": 1, "maxLength": 120 },
        "split": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "time_intent": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": { "type": { "const": "recent_days" }, "days": { "type": "integer", "minimum": 1, "maximum": 3650 } },
          "required": ["type", "days"]
        },
        {
          "properties": { "type": { "const": "explicit_date_range" }, "start": { "type": "string", "format": "date" }, "end": { "type": "string", "format": "date" } },
          "required": ["type", "start", "end"]
        },
        {
          "properties": { "type": { "const": "latest_matching_sessions" }, "count": { "type": "integer", "minimum": 1, "maximum": 20 } },
          "required": ["type", "count"]
        },
        {
          "properties": { "type": { "const": "before_each_target_event" }, "target_draft_id": { "type": "string" }, "days_before": { "type": "integer", "minimum": 1, "maximum": 30 }, "include_target_day": { "type": "boolean" } },
          "required": ["type", "target_draft_id", "days_before", "include_target_day"]
        },
        {
          "properties": { "type": { "const": "unspecified" } },
          "required": ["type"]
        }
      ]
    },
    "notes": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": { "requested": { "const": false }, "scopes": { "const": [] } },
          "required": ["requested", "scopes"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": { "requested": { "const": true }, "scopes": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["daily", "diet", "training", "movement"] } } },
          "required": ["requested", "scopes"]
        }
      ]
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["preceding_event_window"] },
        "source_draft_id": { "type": "string" },
        "dependent_draft_id": { "type": "string" }
      },
      "required": ["type", "source_draft_id", "dependent_draft_id"]
    }
  }
}
