<view class="page reference-page {{selected ? 'selected-theme tone-page-' + area.tone : ''}}">
  <image wx:if="{{selected}}" class="theme-art" src="/images/themes-v2/{{selected}}.webp" mode="aspectFill" />
  <block wx:if="{{!selected}}">
    <view class="eyebrow">BEFORE YOU TRAIN / READ ONLY</view>
    <view class="title">训练部位<br/>档案。</view>
    <view class="intro">不是训练计划。选择今天可能练的部位，快速回看动作、最近表现与历史轨迹。</view>
    <view wx:if="{{freshness}}" class="freshness {{freshness.stale ? 'is-stale' : ''}}">{{freshness.text}}</view>
    <view wx:if="{{loading}}" class="state">正在整理动作档案…</view>
    <view wx:elif="{{error}}" class="state error">{{error}}</view>
    <view wx:else class="area-list">
      <view wx:for="{{areas}}" wx:key="id" class="area-row tone-{{item.tone}}" data-part="{{item.id}}" bindtap="selectArea">
        <view class="area-number">0{{index + 1}}</view>
        <view class="area-name"><text>{{item.cn}}</text><text>{{item.en}}</text></view>
        <view class="area-data"><text>{{item.movement_count || 0}} 动作</text><text>{{item.session_count || 0}} 次训练</text></view>
        <view class="area-arrow">→</view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view wx:if="{{!notepadOpen}}" class="part-hero tone-{{area.tone}} {{notepadTurning ? 'is-turning' : ''}}" bindtap="toggleNotepad">
      <view class="hero-top"><view class="eyebrow">{{area.labelEn}} ARCHIVE</view><view class="flip-hint">FLIP</view></view>
      <view class="part-title">{{area.label}}</view>
      <view class="part-meta">{{area.session_count || 0}} 次训练 · {{area.movement_count || 0}} 个动作</view>
      <view class="part-latest">最近训练 {{area.latest_date || '暂无'}}</view>
    </view>
    <view wx:else class="notepad-sticky"><view class="part-hero notepad-card neutral-notepad {{notepadFlipBack ? 'is-flipping-back' : ''}}" catchtap="noop"><view class="notepad-back-head" bindtap="toggleNotepad"><view><view class="eyebrow">LOCAL ONLY / TRAINING NOTE</view><view class="notepad-title">TRAINING NOTE / 训练记录</view></view><view class="flip-hint">FLIP</view></view><block wx:if="{{!notepadExpanded}}"><textarea class="notepad-input compact-input" value="{{noteText}}" bindinput="onNoteInput" bindblur="onNoteBlur" placeholder="Freeform notes, any format." maxlength="-1" fixed="true"/><view class="notepad-actions"><view bindtap="copyNote">COPY</view><view class="notepad-clear" bindtap="clearNote">CLEAR</view><view bindtap="expandNotepad">EXPAND</view></view></block><block wx:else><textarea class="notepad-input" value="{{noteText}}" bindinput="onNoteInput" bindblur="onNoteBlur" placeholder="Freeform notes, any format." maxlength="-1" fixed="true"/><view class="notepad-actions"><view bindtap="copyNote">COPY ALL</view><view class="notepad-clear" bindtap="clearNote">CLEAR</view><view bindtap="collapseNotepad">COLLAPSE EDIT</view></view></block><view class="notepad-status">已自动保存</view></view></view>
<view wx:if="{{noteCandidatesLoading || noteCandidates.length}}" class="notepad-candidates {{noteCandidatesCollapsed ? 'is-collapsed' : ''}}"><view class="notepad-candidates-head"><text>可能相关动作 · 最近记录</text><text bindtap="toggleNoteCandidates">{{noteCandidatesCollapsed ? '展开' : '收起'}}</text></view><scroll-view wx:if="{{!noteCandidatesCollapsed}}" class="notepad-candidate-scroll" scroll-y enhanced show-scrollbar="false"><view wx:for="{{noteCandidates}}" wx:key="movement_id" class="notepad-candidate" data-id="{{item.movement_id}}" data-part="{{item.body_part}}" bindtap="openNoteCandidate"><view class="notepad-candidate-main"><text>{{item.display_name}}</text><text wx:if="{{item.english_name}}">{{item.english_name}}</text><view wx:for="{{item.previewHistory}}" wx:for-item="record" wx:key="index" class="notepad-candidate-history"><text>{{record.date}}{{record.order ? ' · 第 ' + record.order + ' 个动作' : ''}}</text><view wx:for="{{record.sets}}" wx:for-item="set" wx:key="index" class="notepad-candidate-set"><text class="notepad-candidate-set-index">{{index < 9 ? '0' + (index + 1) : index + 1}}</text><text class="notepad-candidate-set-values">{{set.weightLabel || ''}} {{set.repsLabel || ''}} {{set.setsLabel || ''}}</text></view><text wx:if="{{record.notes}}" class="notepad-candidate-note">{{record.notes}}</text></view></view><view class="notepad-candidate-meta"><text>{{item.body_part_label || '跨部位'}}</text><text>详情 →</text></view></view><view wx:if="{{noteCandidatesLoading && !noteCandidates.length}}" class="notepad-candidates-loading">正在识别动作库…</view></scroll-view></view>
    <view id="notepad-observer-anchor" class="notepad-observer-anchor"></view>
    <view class="reference-notepad-dock"><freeform-notepad visible="{{dockVisible}}" /></view>
    <scroll-view scroll-x class="part-switch" enhanced show-scrollbar="false">
      <view class="part-switch-inner">
        <view wx:for="{{areas}}" wx:key="id" class="part-pill {{selected === item.id ? 'active tone-' + item.tone : ''}}" data-part="{{item.id}}" bindtap="selectArea">{{item.cn}}</view>
      </view>
    </scroll-view>
    <view class="sort-rail">
      <view class="sort-label">排序</view>
      <view class="sort-option {{sortBy === 'frequency' ? 'active' : ''}}" data-sort="frequency" bindtap="setSort">训练频率</view>
      <view class="sort-option {{sortBy === 'recent' ? 'active' : ''}}" data-sort="recent" bindtap="setSort">最近训练</view>
      <view class="sort-option {{sortBy === 'days' ? 'active' : ''}}" data-sort="days" bindtap="setSort">按训练日</view>
    </view>
    <view wx:if="{{loading}}" class="state">正在读取{{area.label || ''}}部档案…</view>
    <view wx:elif="{{error}}" class="state error">{{error}}</view>
    <view wx:elif="{{sortBy !== 'days' && !area.movements.length}}" class="state">该部位暂时没有动作历史。</view>
    <view wx:elif="{{sortBy === 'days' && !area.sessions.length}}" class="state">该部位暂时没有相关训练日。</view>
    <view wx:elif="{{sortBy !== 'days'}}" class="movement-list">
      <view class="list-heading"><view><view class="eyebrow">MOVEMENTS / FREQUENCY</view><view class="section-title">动作与最近表现</view></view><view class="count">{{area.movement_count}}</view></view>
      <view wx:for="{{area.movements}}" wx:key="movement_id" class="movement-card" data-id="{{item.movement_id}}" bindtap="openMovement">
        <view class="movement-head">
          <view><view wx:if="{{item.pinned}}" class="focus-mark">★ FOCUS</view><view class="movement-name">{{item.display_name}}</view><view class="movement-en">{{item.english_name}}</view></view>
          <view class="session-badge">{{item.sessions}} 次</view>
        </view>
        <view class="latest-set" wx:if="{{item.latest}}"><text>最近</text><text>{{item.latest.date}}{{item.latest.order ? ' · 第 ' + item.latest.order + ' 动作' : ''}}</text></view>
        <view class="set-summary clamp-2">{{item.latest.summary || '暂无组数记录'}}</view>
        <view class="compare-grid">
          <view class="compare-cell"><view class="compare-label">上一次</view><view class="compare-value clamp-2">{{item.previous ? item.previous.summary : '首次记录'}}</view></view>
          <view class="compare-cell"><view class="compare-label">历史最好</view><view class="compare-value">{{item.best && item.best.max_weight ? item.best.max_weight + ' kg' : (item.best && item.best.total_reps ? item.best.total_reps + ' reps' : '-')}}</view></view>
        </view>
        <view wx:if="{{item.latest.notes}}" class="movement-note clamp-2">{{item.latest.notes}}</view>
        <view class="movement-action">查看完整轨迹 →</view>
      </view>
    </view>
    <view wx:else class="session-list">
      <view class="list-heading"><view><view class="eyebrow">TRAINING DAYS / RECENT</view><view class="section-title">相关训练日</view></view><view class="count">{{area.sessions.length}}</view></view>
      <view wx:for="{{area.sessions}}" wx:key="id" class="session-card" data-date="{{item.date}}" bindtap="openSession">
        <view class="session-card-head"><text>{{item.date}}</text><text>{{item.title}}</text></view>
        <view class="session-meta"><text>{{item.related_count || 0}} 个相关动作</text><text>完整训练上下文</text></view>
        <view class="session-movement-chips">
          <text wx:for="{{item.related_movements}}" wx:for-item="movement" wx:key="*this" wx:if="{{index < 4}}" class="related-movement">{{movement}}</text>
        </view>
        <view class="session-full-summary clamp-3">{{item.full_summary}}</view>
        <view wx:if="{{item.notes}}" class="session-note clamp-2">{{item.notes}}</view>
        <view class="movement-action">查看当日训练 →</view>
      </view>
    </view>
    <view wx:if="{{noteDetailOpen}}" class="notepad-detail-backdrop" catchtap="closeNoteDetail"><view class="notepad-detail-sheet" catchtap="noop"><view class="notepad-detail-head"><view><view class="eyebrow">MOVEMENT HISTORY / READ ONLY</view><view class="notepad-detail-title">{{noteDetailMovement.display_name || '动作记录'}}</view><view wx:if="{{noteDetailMovement.english_name}}" class="notepad-detail-en">{{noteDetailMovement.english_name}}</view></view><view class="notepad-detail-close" bindtap="closeNoteDetail">关闭</view></view><view wx:if="{{noteDetailMovement.muscle_group}}" class="notepad-detail-meta">{{noteDetailMovement.muscle_group}}</view><view wx:if="{{noteDetailLoading}}" class="notepad-detail-state">正在读取完整轨迹…</view><view wx:elif="{{noteDetailError}}" class="notepad-detail-state error">{{noteDetailError}}</view><view wx:elif="{{!noteDetailHistory.length}}" class="notepad-detail-state">暂无历史记录</view><scroll-view wx:else class="notepad-detail-scroll" scroll-y enhanced show-scrollbar="false"><view wx:for="{{noteDetailHistory}}" wx:key="index" class="notepad-detail-record"><view class="notepad-detail-record-head"><text>{{item.date}}</text><text wx:if="{{item.order}}">第 {{item.order}} 个动作</text></view><view wx:for="{{item.sets}}" wx:for-item="set" wx:key="index" class="notepad-detail-set"><text wx:if="{{set.weightLabel}}">{{set.weightLabel}}</text><text wx:if="{{set.repsLabel}}">{{set.repsLabel}}</text><text wx:if="{{set.setsLabel}}">{{set.setsLabel}}</text><text wx:if="{{!set.weightLabel && !set.repsLabel && !set.setsLabel}}">原始组数据</text></view><view wx:if="{{item.notes}}" class="notepad-detail-notes">备注：{{item.notes}}</view></view></scroll-view></view></view>
  </block>
</view>
