<view class="notepad-dock {{visible ? 'is-visible' : 'is-hidden'}}"><view wx:if="{{!open}}" class="notepad-dock-bar" bindtap="toggle"><view><text>TRAINING NOTE</text><text class="notepad-dock-saved"> · 已自动保存</text></view><text>展开</text></view><view wx:else class="notepad-dock-card"><view class="notepad-dock-head"><view><view class="eyebrow">LOCAL ONLY</view><view class="notepad-dock-title">TRAINING NOTE / 训练记录</view></view><view class="notepad-collapse" bindtap="toggle">收拢</view></view><textarea class="notepad-dock-input" value="{{text}}" bindinput="onInput" bindchange="onChange" bindblur="onBlur" placeholder="自由记录本次训练，支持任意格式……" maxlength="-1"/><view wx:if="{{candidatesLoading || candidates.length}}" class="notepad-candidates {{candidatesCollapsed ? 'is-collapsed' : ''}}"><view class="notepad-candidates-head"><text>可能相关动作 · 最近记录</text><text bindtap="toggleCandidates">{{candidatesCollapsed ? '展开' : '收起'}}</text></view><scroll-view wx:if="{{!candidatesCollapsed}}" class="notepad-candidate-scroll" scroll-y enhanced show-scrollbar="false"><view wx:for="{{candidates}}" wx:key="movement_id" class="notepad-candidate" data-id="{{item.movement_id}}" data-name="{{item.display_name}}" data-part="{{item.body_part}}" bindtap="openCandidate"><view class="notepad-candidate-main"><text>{{item.display_name}}</text><text wx:if="{{item.english_name}}">{{item.english_name}}</text><view wx:for="{{item.previewHistory}}" wx:for-item="record" wx:key="index" class="notepad-candidate-history"><text>{{record.date}}{{record.order ? ' · 第 ' + record.order + ' 个动作' : ''}}</text><view wx:for="{{record.sets}}" wx:for-item="set" wx:key="index" class="notepad-candidate-set"><text class="notepad-candidate-set-index">{{index < 9 ? '0' + (index + 1) : index + 1}}</text><text class="notepad-candidate-set-values">{{set.weightLabel || ''}} {{set.repsLabel || ''}} {{set.setsLabel || ''}}</text></view><text wx:if="{{record.notes}}" class="notepad-candidate-note">{{record.notes}}</text></view></view><view class="notepad-candidate-meta"><text>{{item.body_part_label || '跨部位'}}</text><text>详情 →</text></view></view><view wx:if="{{candidatesLoading && !candidates.length}}" class="notepad-candidates-loading">正在识别动作库…</view></scroll-view></view><view class="notepad-dock-actions"><view bindtap="copy">复制全部</view><view class="notepad-dock-clear" bindtap="clear">清空</view></view><view class="notepad-dock-status">已自动保存到本地</view></view><view wx:if="{{detailOpen}}" class="notepad-detail-backdrop" catchtap="closeDetail"><view class="notepad-detail-sheet" catchtap="noop"><view class="notepad-detail-head"><view><view class="eyebrow">MOVEMENT HISTORY / READ ONLY</view><view class="notepad-detail-title">{{detailMovement.display_name || '动作记录'}}</view><view wx:if="{{detailMovement.english_name}}" class="notepad-detail-en">{{detailMovement.english_name}}</view></view><view class="notepad-detail-close" bindtap="closeDetail">关闭</view></view><view wx:if="{{detailMovement.muscle_group}}" class="notepad-detail-meta">{{detailMovement.muscle_group}}</view><view wx:if="{{detailLoading}}" class="notepad-detail-state">正在读取完整轨迹…</view><view wx:elif="{{detailError}}" class="notepad-detail-state error">{{detailError}}</view><view wx:elif="{{!detailHistory.length}}" class="notepad-detail-state">暂无历史记录</view><scroll-view wx:else class="notepad-detail-scroll" scroll-y enhanced show-scrollbar="false"><view wx:for="{{detailHistory}}" wx:key="index" class="notepad-detail-record"><view class="notepad-detail-record-head"><text>{{item.date}}</text><text wx:if="{{item.order}}">第 {{item.order}} 个动作</text></view><view wx:for="{{item.sets}}" wx:for-item="set" wx:key="index" class="notepad-detail-set"><text wx:if="{{set.weightLabel}}">{{set.weightLabel}}</text><text wx:if="{{set.repsLabel}}">{{set.repsLabel}}</text><text wx:if="{{set.setsLabel}}">{{set.setsLabel}}</text><text wx:if="{{!set.weightLabel && !set.repsLabel && !set.setsLabel}}">原始组数据</text></view><view wx:if="{{item.notes}}" class="notepad-detail-notes">备注：{{item.notes}}</view></view></scroll-view></view></view></view>
