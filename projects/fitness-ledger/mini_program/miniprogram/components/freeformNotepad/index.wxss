:host { position:fixed; top:calc(env(safe-area-inset-top) + 14rpx); right:22rpx; left:22rpx; z-index:20; pointer-events:none; }.notepad-dock { pointer-events:auto; opacity:1; transform:translateY(0); transition:opacity .2s ease-out,transform .2s ease-out,visibility .16s ease-out; }.notepad-dock.is-hidden { opacity:0; transform:translateY(-10rpx); visibility:hidden; pointer-events:none; transition-duration:.16s; }.notepad-dock-bar { display:flex; align-items:center; justify-content:space-between; padding:16rpx 20rpx; border:1rpx solid rgba(55,51,43,.18); border-radius:999rpx; background:rgba(252,249,242,.97); box-shadow:0 8rpx 22rpx rgba(53,44,29,.15); color:#302d27; font-size:20rpx; }.notepad-dock-saved { color:#8a6a14; }.notepad-dock-card { max-height:66vh; padding:22rpx; border:1rpx solid rgba(55,51,43,.2); border-radius:12rpx 30rpx 30rpx 30rpx; background:#fcf9f2; box-shadow:0 12rpx 34rpx rgba(53,44,29,.18); }.notepad-dock-head { display:flex; justify-content:space-between; align-items:flex-start; }.notepad-dock-title { margin-top:4rpx; font-family:"Songti SC",serif; font-size:36rpx; }.notepad-collapse { padding-bottom:4rpx; border-bottom:1rpx solid currentColor; font-size:20rpx; }.notepad-dock-input { display:block; box-sizing:border-box; width:100%; height:300rpx; max-height:42vh; margin-top:16rpx; padding:12rpx 0; border-top:1rpx solid rgba(23,23,20,.18); border-bottom:1rpx solid rgba(23,23,20,.12); background:transparent; color:#27251f; font-size:24rpx; line-height:1.55; }.notepad-candidates { margin-top:14rpx; padding-top:12rpx; border-top:1rpx solid rgba(23,23,20,.12); }.notepad-candidates-head { display:flex; justify-content:space-between; align-items:baseline; color:#6d5a28; font-size:18rpx; letter-spacing:1rpx; }.notepad-candidates-head text:last-child { color:rgba(23,23,20,.48); font-size:16rpx; letter-spacing:0; }.notepad-candidate { display:flex; align-items:center; justify-content:space-between; gap:12rpx; margin-top:9rpx; padding:10rpx 12rpx; border:1rpx solid rgba(138,91,0,.18); border-radius:12rpx; background:rgba(255,218,110,.16); }.notepad-candidate-main { display:flex; min-width:0; flex-direction:column; }.notepad-candidate-main text:first-child { overflow:hidden; color:#383128; font-family:"Songti SC",serif; font-size:25rpx; text-overflow:ellipsis; white-space:nowrap; }.notepad-candidate-main text:last-child { margin-top:2rpx; overflow:hidden; color:#847765; font-size:16rpx; text-overflow:ellipsis; white-space:nowrap; }.notepad-candidate-meta { display:flex; flex:none; flex-direction:column; align-items:flex-end; color:#8a6a14; font-size:16rpx; }.notepad-candidate-meta text:last-child { margin-top:3rpx; color:#6d5a28; font-size:17rpx; }.notepad-candidates-loading { margin-top:8rpx; color:rgba(23,23,20,.48); font-size:16rpx; }.notepad-dock-actions { display:flex; gap:28rpx; margin-top:14rpx; font-size:20rpx; font-weight:650; }.notepad-dock-clear { color:#8b493d; }.notepad-dock-status { margin-top:9rpx; color:rgba(23,23,20,.55); font-size:17rpx; }
.notepad-detail-backdrop { position:fixed; z-index:60; top:0; right:0; bottom:0; left:0; box-sizing:border-box; padding:110rpx 18rpx 42rpx; background:rgba(28,25,20,.38); }
.notepad-detail-sheet { box-sizing:border-box; width:100%; max-height:82vh; overflow:hidden; padding:28rpx 26rpx 24rpx; border:1rpx solid rgba(23,23,20,.16); border-radius:28rpx; background:#fcf9f2; box-shadow:0 18rpx 46rpx rgba(23,23,20,.22); }
